#!/usr/bin/env bash
# pre-commit: the fast gates, in seconds, on every commit.
#
#   1. gitleaks on the staged changes (secrets)
#   2. npm run verify: typecheck, lint, unit tests
#
# Install once per clone:  bin/setup-git-hooks.sh
# Emergency bypass:        git commit --no-verify   (and say so in the PR)
set -euo pipefail

# git hands the hook an index that points at the commit in progress. Child
# processes that run git (tests often do) must not inherit it.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_PREFIX

RED='\033[0;31m'; YEL='\033[0;33m'; GRN='\033[0;32m'; RST='\033[0m'
fail() { echo -e "${RED}pre-commit: FAIL${RST} - $1" >&2; exit 1; }
warn() { echo -e "${YEL}pre-commit: warn${RST} - $1" >&2; }
ok()   { echo -e "${GRN}pre-commit: ok${RST} - $1"; }

cd "$(git rev-parse --show-toplevel)"

# 1. Secrets
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner >/dev/null 2>&1 \
    || gitleaks protect --staged --redact --no-banner \
    || fail "gitleaks found something that looks like a secret in the staged changes"
  ok "gitleaks: no secrets in the staged changes"
else
  warn "gitleaks is not installed, so secrets were not scanned. Install it: brew install gitleaks"
fi

# 2. Typecheck, lint, unit tests
npm run verify || fail "verify failed. Read the output above, fix it, and commit again."
ok "verify: typecheck, lint and tests are green"
