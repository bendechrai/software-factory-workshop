#!/usr/bin/env bash
# pre-push: the thorough gates, on the exact commit being pushed.
#
# There is no hosted CI for this repository. Everything a pipeline would do
# runs here instead, through bin/preflight.sh, which exports the commit into
# a clean folder so that an uncommitted file cannot make the checks pass.
#
# Waive the browser test for one push (loudly):  PUSH_SKIP_E2E=1 git push
# Emergency bypass:                              git push --no-verify
set -euo pipefail

RED='\033[0;31m'; YEL='\033[1;33m'; GRN='\033[0;32m'; DIM='\033[2m'; RST='\033[0m'
cd "$(git rev-parse --show-toplevel)"

ARGS=()
if [ "${PUSH_SKIP_E2E:-}" = "1" ]; then
  ARGS+=(--skip-e2e)
  echo -e "${YEL}**********************************************************${RST}" >&2
  echo -e "${YEL}  WAIVED: e2e - PUSH_SKIP_E2E=1 is set. The browser test${RST}" >&2
  echo -e "${YEL}  will not run for this push. Write it in the pull request${RST}" >&2
  echo -e "${YEL}  as:  Waived: e2e - <reason>${RST}" >&2
  echo -e "${YEL}**********************************************************${RST}" >&2
fi

checked=""
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # a delete: nothing to test
  commit="$(git rev-parse --verify --quiet "${local_sha}^{commit}")" || continue
  tree="$(git rev-parse "${commit}^{tree}")"
  case " $checked " in *" $tree "*) continue ;; esac
  checked="$checked $tree"
  echo -e "${GRN}pre-push: gates for ${local_ref} ($(git rev-parse --short "$commit"))${RST}"
  bin/preflight.sh "$commit" ${ARGS[@]+"${ARGS[@]}"} \
    || { echo -e "${RED}pre-push: FAIL${RST} - preflight failed. Push refused." >&2; exit 1; }
done
echo -e "${GRN}pre-push: all gates passed.${RST}"
